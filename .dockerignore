# The Dockerfile copies exactly the Gradle inputs and src/; everything else is context weight
# uploaded to the daemon on every `docker compose build`. Notably docs/media carries a local
# Playwright install once the README screenshots have been regenerated (docs/media/README.md).
.git/
.gradle/
build/
docs/
# The console (M8) never ships in this image — only its build script enters the context,
# because settings.gradle.kts includes the project and Gradle must evaluate it.
console/**
!console/build.gradle.kts
